# Variables de entorno para la conexión a PostgreSQL
# Copiar este archivo a ".env" y completar con los valores reales:
#   cp .env.example .env
#
# NUNCA subir el archivo ".env" a GitHub (ya está incluido en .gitignore)

DB_HOST=localhost
DB_PORT=5432
DB_USER=chatbot_app
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=chatbot_db
